{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/extension.ts",
    "src/cli/main.ts",
    "src/cli/index.ts",
    "src/core/index.ts",
    "src/webview/app/index.tsx",
    "playwright.component-screenshots.config.ts",
    "src/**/*.test.ts",
    "tests/**/*.spec.ts",
    "tests/component-screenshots/harness.tsx",
    "scripts/*.mjs"
