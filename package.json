{
  "name": "aist",
  "displayName": "aist",
  "description": "Minimal VS Code coding agent powered by OpenRouter or ChatGPT Codex.",
  "version": "0.0.8",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/stray-live-pixel/aist.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:openrouterAgent.openChat",
    "onCommand:openrouterAgent.newChat",
    "onCommand:openrouterAgent.openSettings",
    "onCommand:openrouterAgent.openStorage",
    "onCommand:openrouterAgent.showLogs",
    "onCommand:openrouterAgent.editSelection",
    "onCommand:openrouterAgent.codexLogin",
    "onCommand:openrouterAgent.codexLogout",
    "onView:openrouterAgent.chats"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openrouterAgent",
          "title": "aist",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "openrouterAgent": [
        {
          "type": "webview",
          "id": "openrouterAgent.chats",
          "name": "Chats"
        }
      ]
    },
    "commands": [
      {
        "command": "openrouterAgent.openChat",
        "title": "aist: Open Chat"
      },
      {
        "command": "openrouterAgent.newChat",
        "title": "aist: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "openrouterAgent.openChatInEditor",
        "title": "aist: Open Chat in Editor",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "openrouterAgent.openSettings",
        "title": "aist: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openrouterAgent.openStorage",
        "title": "aist: Open Extension Storage",
        "icon": "$(folder-opened)"
      },
      {
        "command": "openrouterAgent.editSelection",
        "title": "aist: Edit Selection"
      },
      {
        "command": "openrouterAgent.showLogs",
        "title": "aist: Show Logs"
      },
      {
        "command": "openrouterAgent.codexLogin",
        "title": "aist: Login ChatGPT Codex"
      },
      {
        "command": "openrouterAgent.codexLogout",
        "title": "aist: Logout ChatGPT Codex"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openrouterAgent.newChat",
          "when": "view == openrouterAgent.chats",
          "group": "navigation@1"
        },
        {
          "command": "openrouterAgent.openSettings",
          "when": "view == openrouterAgent.chats",
          "group": "navigation@2"
        },
        {
          "command": "openrouterAgent.openStorage",
          "when": "view == openrouterAgent.chats",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "aist",
      "properties": {
        "openrouterAgent.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "OpenRouter API key. You can also set the `OPENROUTER_API_KEY` environment variable."
        },
        "openrouterAgent.model": {
          "type": "string",
          "default": "openai/gpt-4o-mini",
          "description": "Model id. OpenRouter ids are used as-is; ChatGPT Codex ids use the codex: prefix, for example codex:gpt-5.1-codex."
        },
        "openrouterAgent.siteUrl": {
          "type": "string",
          "default": "",
          "description": "Optional site URL sent to OpenRouter for rankings."
        },
        "openrouterAgent.siteName": {
          "type": "string",
          "default": "aist",
          "description": "Optional site name sent to OpenRouter for rankings."
        },
        "openrouterAgent.maxContextChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum characters from the active file sent as context."
        },
        "openrouterAgent.maxToolIterations": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum number of model/tool-call turns per request. Use 0 for no limit."
        },
        "openrouterAgent.reasoningEffort": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ],
          "default": "auto",
          "description": "Reasoning effort sent to OpenRouter. Auto does not send a reasoning parameter."
        },
        "openrouterAgent.language": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "Русский",
            "English"
          ],
          "default": "en",
          "description": "Language for agent answers and tool-call explanations."
        },
        "openrouterAgent.agentMode": {
          "type": "string",
          "default": "default",
          "description": "Active agent working mode ID."
        },
        "openrouterAgent.agentModeInstructions": {
          "type": "object",
          "default": {},
          "description": "Custom instructions per agent mode."
        },
        "openrouterAgent.customAgentModes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "instructions"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              }
            }
          },
          "description": "User-defined custom agent modes."
        },
        "openrouterAgent.agentConfigScope": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "default": "workspace",
          "description": "Where AIST stores project-specific agent instructions, modes, and custom skills. Workspace uses .aist-agent/settings.json; user keeps data outside the repository."
        },
        "openrouterAgent.customSkills": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "markdownDescription": "Bash script executed from the workspace. The optional `run_skill.input` value is available through stdin and `AIST_SKILL_INPUT`."
              },
              "permission": {
                "type": "string",
                "enum": [
                  "ask",
                  "auto"
                ],
                "default": "ask",
                "description": "Whether this skill requires confirmation before it runs."
              }
            }
          },
          "markdownDescription": "User-defined custom skills the agent can run through the `run_skill` tool. Skills default to requiring confirmation."
        },
        "openrouterAgent.approvalNotifications": {
          "type": "object",
          "default": {
            "enabled": true,
            "systemNotifications": true,
            "sound": true,
            "volume": 0.35,
            "durationSeconds": 5
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "systemNotifications": {
              "type": "boolean",
              "default": true
            },
            "sound": {
              "type": "boolean",
              "default": true
            },
            "volume": {
              "type": "number",
              "default": 0.35,
              "minimum": 0,
              "maximum": 1
            },
            "durationSeconds": {
              "type": "number",
              "default": 5,
              "minimum": 1,
              "maximum": 30
            }
          },
          "markdownDescription": "Notification settings for tool-call approval prompts. AIST can show a system notification and play a gentle bell while waiting for the user's decision."
        },
        "openrouterAgent.toolPermissions": {
          "type": "object",
          "default": {
            "get_workspace_info": "auto",
            "list_files": "auto",
            "read_file": "auto",
            "grep_search": "auto",
            "run_bash_script": "ask",
            "write_file": "ask",
            "replace_in_file": "ask",
            "create_directory": "ask",
            "delete_path": "ask"
          },
          "markdownDescription": "Per-tool permission mode. Use `ask` to require confirmation or `auto` to run automatically. File-reading tools default to `auto`; mutating tools default to `ask`."
        }
      }
    }
  },
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build:webview": "node scripts/build-webview.mjs",
    "build:component-screenshots": "esbuild tests/component-screenshots/harness.tsx --bundle --format=iife --outfile=tests/component-screenshots/harness.js --loader:.css=css --loader:.scss=local-css",
    "build:e2e": "npm run build:extension && npm run build:webview",
    "build": "npm run typecheck && npm run build:extension && npm run build:webview",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:components:screenshots": "npm run build:component-screenshots && playwright test -c playwright.component-screenshots.config.ts",
    "test:components:screenshots:update": "npm run build:component-screenshots && playwright test -c playwright.component-screenshots.config.ts --update-snapshots",
    "test:e2e:debug": "npm run build:e2e && playwright test --debug",
    "test:e2e:ui": "npm run build:e2e && playwright test --ui",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "package": "npm run build && vsce package --no-dependencies",
    "install:extension": "node scripts/install-extension.mjs",
    "watch:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --watch",
    "watch:webview": "esbuild src/webview/app/index.tsx --bundle --format=iife --outfile=dist/webview.js --watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.28.0",
    "esbuild-sass-plugin": "^3.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{css,html,json,jsx,md,ts,tsx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
